#!/bin/bash
# SPDX-License-Identifier: MIT-0

set -euxo pipefail

poetry --version

# Set two environment variables for promoting warnings to errors:
#   DRAKE_DEPRECATION_RUNTIME_SEVERITY=error so DrakeDeprecationWarnings
#     from pydrake are propagated as errors. Without this, pydrake's
#     default "once" filter sits at position 0 of the warnings filter
#     list and shadows PYTHONWARNINGS=error for this category.
#   PYTHONWARNINGS=error so any other Python warning is also promoted
#     to a test failure.
# We scope the environment variables to the inner python via `env` rather than
# exporting them, because `poetry` itself calls a deprecated importlib.resources
# API and would abort under PYTHONWARNINGS=error before it could launch the
# test. See https://github.com/RobotLocomotion/drake/issues/25134.
cd src
poetry run env DRAKE_DEPRECATION_RUNTIME_SEVERITY=error \
  PYTHONWARNINGS=error python particle_test.py
poetry run env DRAKE_DEPRECATION_RUNTIME_SEVERITY=error \
  PYTHONWARNINGS=error python find_resource_example.py

cd ..
rm -rf src/__pycache__
